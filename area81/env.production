###############################################
# Aplicação
###############################################
APP_NAME="AREA81"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://area81.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

# Depois de copiar este arquivo, gere a chave:  php artisan key:generate

###############################################
# Log  (nível debug — você gosta de logar tudo)
###############################################
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=30
# O canal "newsletter" (config/logging.php) registra cada passo do double opt-in.
# Se o volume incomodar, suba para info ou warning.

###############################################
# Banco de dados — MariaDB 11.8
###############################################
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=area81
DB_USERNAME=area81
DB_PASSWORD=COLE_A_SENHA_DO_BANCO

###############################################
# Sessão / Cache / Fila  (tudo no banco)
###############################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database

# Fila no banco — o worker processa o auto-envio da newsletter
QUEUE_CONNECTION=database

###############################################
# E-mail — Resend
###############################################
MAIL_MAILER=resend
RESEND_API_KEY=COLE_O_TOKEN_DO_RESEND
MAIL_FROM_ADDRESS="news@area81.com.br"
MAIL_FROM_NAME="${APP_NAME}"

###############################################
# IA — SHVIA (camada de IA do projeto)
###############################################
SHVIA_API_URL=http://127.0.0.1:8001
SHVIA_API_TOKEN=COLE_O_TOKEN_DA_SHVIA

# Se o blog for falar direto com o Ollama em vez da API do SHVIA:
# OLLAMA_URL=http://127.0.0.1:11434

###############################################
# Filesystem  (uploads de imagens dos posts)
###############################################
FILESYSTEM_DISK=public
# Lembre de rodar uma vez:  php artisan storage:link

###############################################
# Build de assets
###############################################
VITE_APP_NAME="${APP_NAME}"
